<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Dyshuaping.TextButton" parent="">
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
    </style>

    <style name="Widget.Dyshuaping.TextButton.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Dyshuaping.TextButton.Success">
        <item name="android:background">@drawable/bg_button_success</item>
        <item name="android:textColor">#08130D</item>
    </style>

    <style name="Widget.Dyshuaping.TextButton.Warning">
        <item name="android:background">@drawable/bg_button_warning</item>
        <item name="android:textColor">#160F02</item>
    </style>

    <style name="Widget.Dyshuaping.TextButton.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">#180707</item>
    </style>

    <style name="Widget.Dyshuaping.TextButton.Small" parent="Widget.Dyshuaping.TextButton">
        <item name="android:minHeight">34dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
    </style>
</resources>
